# Copy this file, name the copy bot.env (same folder), and fill in the values. Never share or commit bot.env.
DISCORD_BOT_TOKEN=paste-the-token-here
DISCORD_OWNER_IDS=owner-id-1,owner-id-2
DISCORD_CHANNEL_IDS=mod=channel-id,voting=channel-id,settings=channel-id
# Optional: lets the bot read private repos for `!usp summary`. A token with read-only access to the repo.
GITHUB_TOKEN=paste-a-read-only-token-here
